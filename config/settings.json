{
  "fusion_weights": {
    "negative": {
      "acoustic": 0.3,
      "prosody": 0.15,
      "paralang": 0.1,
      "physical": 0.05,
      "text_llm": 0.3,
      "text_stat": 0.1
    },
    "arousal": {
      "acoustic": 0.35,
      "prosody": 0.25,
      "paralang": 0.15,
      "physical": 0.1,
      "text_llm": 0.1,
      "text_stat": 0.05
    }
  },
  "audio": {
    "sample_rate": 16000,
    "channels": 1,
    "record_duration_max": 60,
    "chunk_size": 1024,
    "stimulus_sample_rate": 44100,
    "stimulus_channels": 2,
    "stimulus_duration_sec": 30,
    "stimulus_min_sec": 10,
    "stimulus_max_sec": 120,
    "calibration_duration_sec": 30
  },
  "models": {
    "device": "auto",
    "asr_device": "cuda",
    "asr_model": "iic/speech_paraformer-large-vad-punc_asr_nat-zh-cn-16k-common-vocab8404-pytorch",
    "asr_revision": "v2.0.4",
    "emotion_model": "iic/emotion2vec_plus_large",
    "emotion_revision": "v2.0.5",
    "emotion_backoff": "iic/emotion2vec_plus_base",
    "llm_model": "Qwen/Qwen3-1.7B",
    "llm_gguf_model": "qwen3-1.7b-instruct-q4_k_m.gguf",
    "panns_checkpoint": "Cnn10_mAP=0.380.pth",
    "use_gguf_on_mps": true,
    "max_new_tokens": 16
  },
  "thresholds": {
    "snr_warning_db": 10,
    "snr_weight_floor": 0.3,
    "paralang_confidence_threshold": 0.3,
    "paralang_boost_threshold": 0.8,
    "asr_confidence_threshold": 0.85,
    "quadrant_mid_v": 0.5,
    "quadrant_mid_a": 0.5,
    "quadrant_band": 0.05,
    "_asr_confidence_note": "v0.4 起 asr_confidence 为 Paraformer token 后验均值（干净语音通常 > 0.9），低于此值时文本模态权重按比例衰减；代理指标回退时量纲不同，见 research_notes §2.3"
  },
  "stimulus": {
    "max_peak_dbfs": -10,
    "fade_ms": 50,
    "crossfade_ms": 200,
    "haas_delay_ms": 12
  },
  "history": {
    "max_records": 200,
    "auto_export_on_clear": true
  },
  "fusion_calibration": {
    "enabled": true,
    "path": "config/modality_calibration.json",
    "personal": true,
    "personal_path": null
  },
  "fusion_mode": "weighted",
  "learned_fusion_path": "config/learned_fusion.json",
  "session": {
    "ema_alpha": 0.5,
    "hysteresis_band": 0.05,
    "min_consecutive": 2,
    "_note": "会话内状态估计：EMA 平滑系数、象限切换死区、切换所需连续段数（见 research_notes §2.8）"
  }
}
